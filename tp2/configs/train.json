{
  "seed": 42,
  "valid_size": 0.2,
  "test_size": 0.2,
  "threshold": 0.5,
  "selection": {
    "metric": "average_precision",
    "tie_tolerance": 0.005,
    "rule": "Highest validation average precision among learned models; if another model is within tie_tolerance of the best, keep the one listed first (simpler)."
  },
  "models": {
    "logistic_regression": {
      "class": "LogisticRegression",
      "params": {"max_iter": 1000}
    },
    "decision_tree": {
      "class": "DecisionTreeClassifier",
      "params": {"max_depth": 5, "min_samples_leaf": 20, "random_state": 42}
    },
    "random_forest": {
      "class": "RandomForestClassifier",
      "params": {"n_estimators": 300, "max_depth": 8, "min_samples_leaf": 10, "random_state": 42, "n_jobs": -1}
    }
  },
  "baseline": {
    "class": "DummyClassifier",
    "params": {"strategy": "most_frequent"}
  }
}
